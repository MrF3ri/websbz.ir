APP_NAME=Websbz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://menu.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=websbz
DB_USERNAME=websbz
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# The app service is private; TRUSTED_PROXIES=* is acceptable only on this isolated network.
# If you use fixed proxy IPs, replace * with their comma-separated addresses.
TRUSTED_PROXIES=*

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Websbz

APP_IMAGE=websbz:production
WEB_PORT=8080
