FROM node:22-bookworm-slim AS node-runtime

FROM php:8.5-fpm-bookworm AS runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends \
        libicu-dev libzip-dev libonig-dev libpq-dev \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_pgsql mbstring intl zip bcmath \
    && php -r 'if (! extension_loaded("Zend OPcache")) { fwrite(STDERR, "PHP 8.5 image must provide Zend OPcache.\\n"); exit(1); }' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /var/www/html/storage/app/private \
        /var/www/html/storage/framework/cache \
        /var/www/html/storage/framework/sessions \
        /var/www/html/storage/framework/views \
        /var/www/html/storage/logs \
        /var/www/html/bootstrap/cache \
    && chown -R app:app /var/www/html/storage /var/www/html/bootstrap/cache \
    && sed -i 's/^user = www-data/user = app/; s/^group = www-data/group = app/; s/^;*clear_env = .*/clear_env = no/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's#^;*pid = .*#pid = /tmp/php-fpm.pid#' /usr/local/etc/php-fpm.conf \
    && sed -i 's#^;*error_log = .*#error_log = /proc/self/fd/2#' /usr/local/etc/php-fpm.conf

COPY docker/php/production.ini /usr/local/etc/php/conf.d/99-production.ini

WORKDIR /var/www/html

FROM runtime-base AS build

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=node-runtime /usr/local/ /usr/local/

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-progress \
    --optimize-autoloader \
    --no-scripts

COPY . .

RUN composer dump-autoload --no-dev --optimize --classmap-authoritative
RUN npm ci && npm run build && rm -rf node_modules
RUN chown -R app:app storage bootstrap/cache

FROM runtime-base AS production

COPY --from=build --chown=app:app /var/www/html /var/www/html

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

USER app

EXPOSE 9000

CMD ["php-fpm", "-F"]
