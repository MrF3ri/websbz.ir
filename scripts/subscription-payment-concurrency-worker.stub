<?php

use App\Models\User;
use App\Modules\Subscription\Actions\ProcessPaymentCallbackAction;
use App\Modules\Subscription\Actions\ReviewManualPaymentAction;
use App\Modules\Subscription\Contracts\PaymentGatewayInterface;
use App\Modules\Subscription\Enums\GatewayVerificationResult;
use App\Modules\Subscription\Models\Payment;
use Illuminate\Support\Facades\DB;

require dirname(__DIR__).'/vendor/autoload.php';

/** @var \Illuminate\Foundation\Application $app */
$app = require dirname(__DIR__).'/bootstrap/app.php';
$app->make(\Illuminate\Contracts\Console\Kernel::class)->bootstrap();

if (! app()->environment('testing')) {
    fwrite(STDERR, "This worker is only available in the testing environment.\n");
    exit(2);
}

[
    $paymentId,
    $reviewerId,
    $signalDirectory,
    $workerId,
    $holdAfterLock,
    $mode,
] = array_pad(array_slice($argv, 1), 6, null);

$paymentId = (int) $paymentId;
$reviewerId = (int) $reviewerId;
$holdAfterLock = $holdAfterLock === '1';
$mode = $mode ?? 'review';

if (! is_dir((string) $signalDirectory)) {
    fwrite(STDERR, "Invalid worker signal directory.\n");
    exit(2);
}

DB::connection()->selectOne(
    "select set_config('application_name', ?, false)",
    ['subscription-worker-'.$workerId],
);

file_put_contents($signalDirectory.'/'.$workerId.'.started', 'started');

$paymentLockObserved = false;

DB::listen(function (\Illuminate\Database\Events\QueryExecuted $query) use (
    &$paymentLockObserved,
    $signalDirectory,
    $workerId,
    $holdAfterLock,
    $mode,
): void {
    $sql = strtolower($query->sql);
    $lockedTable = $mode === 'expire' ? 'subscriptions' : 'payments';

    if (
        $paymentLockObserved
        || ! str_contains($sql, 'for update')
        || ! preg_match('/\bfrom\s+["`]?payments["`]?/', $sql)
    ) {
        return;
    }

    $paymentLockObserved = true;
    file_put_contents($signalDirectory.'/'.$workerId.'.locked', 'locked');

    if (! $holdAfterLock) {
        return;
    }

    $gate = fopen($signalDirectory.'/gate', 'c+');

    if ($gate === false) {
        throw new \RuntimeException('Unable to open the concurrency gate.');
    }

    try {
        if (! flock($gate, LOCK_EX)) {
            throw new \RuntimeException('Unable to wait on the concurrency gate.');
        }

        flock($gate, LOCK_UN);
    } finally {
        fclose($gate);
    }
});

$result = ['status' => 'error', 'message' => 'Worker did not execute.'];

try {
    if ($mode === 'expire') {
        $expiredCount = app(\\App\\Modules\\Subscription\\Actions\\ExpireSubscriptionsAction::class)->execute();
        $processedStatus = 'expired:'.$expiredCount;
        $processedId = $paymentId;
    } elseif ($mode === 'callback') {
        app()->instance(PaymentGatewayInterface::class, new class implements PaymentGatewayInterface {
            public function initiatePayment(Payment $payment): string
            {
                return 'https://gateway.test/checkout';
            }

            public function verifyPayment(string $gatewayReference): GatewayVerificationResult
            {
                return GatewayVerificationResult::SUCCESS;
            }
        });

        $processed = app(ProcessPaymentCallbackAction::class)->execute(
            Payment::query()->findOrFail($paymentId)->gateway_reference,
        );
    } else {
        $payment = Payment::query()->findOrFail($paymentId);
        $reviewer = User::query()->findOrFail($reviewerId);
        $processed = app(ReviewManualPaymentAction::class)->approve($payment, $reviewer);
    }

    if (! isset($processedStatus)) {
        $processedStatus = $processed->status->value;
        $processedId = $processed->getKey();
    }

    $result = [
        'status' => $processedStatus,
        'payment_id' => $processedId,
    ];
} catch (\Throwable $exception) {
    $result = [
        'status' => 'error',
        'exception' => $exception::class,
        'message' => $exception->getMessage(),
    ];
}

file_put_contents(
    $signalDirectory.'/'.$workerId.'.result',
    json_encode($result, JSON_THROW_ON_ERROR),
);

exit($result['status'] === 'error' ? 1 : 0);
