<?php

use App\Modules\Menu\Actions\SaveMenuTranslationsAction;
use App\Modules\Menu\Models\Menu;
use Illuminate\Support\Facades\DB;

require dirname(__DIR__).'/vendor/autoload.php';

/** @var \Illuminate\Foundation\Application $app */
$app = require dirname(__DIR__).'/bootstrap/app.php';
$app->make(\Illuminate\Contracts\Console\Kernel::class)->bootstrap();

if (! app()->environment('testing')) {
    fwrite(STDERR, "This worker is only available in the testing environment.\n");
    exit(2);
}

[
    $menuId,
    $locale,
    $menuTitle,
    $categoryPublicId,
    $categoryName,
    $productPublicId,
    $productName,
    $productDescription,
    $signalDirectory,
    $workerId,
    $holdAfterLock,
    $failAfterLock,
] = array_pad(array_slice($argv, 1), 12, null);

$menuId = (int) $menuId;
$holdAfterLock = $holdAfterLock === '1';
$failAfterLock = $failAfterLock === '1';

if (! in_array($locale, ['en', 'ar'], true) || ! is_dir((string) $signalDirectory)) {
    fwrite(STDERR, "Invalid translation worker arguments.\n");
    exit(2);
}

DB::connection()->selectOne(
    "select set_config('application_name', ?, false)",
    ['translation-worker-'.$workerId],
);

file_put_contents($signalDirectory.'/'.$workerId.'.started', 'started');

$menuLockObserved = false;

DB::listen(function (\Illuminate\Database\Events\QueryExecuted $query) use (
    &$menuLockObserved,
    $signalDirectory,
    $workerId,
    $holdAfterLock,
    $failAfterLock,
): void {
    $sql = strtolower($query->sql);

    if (
        $menuLockObserved
        || ! str_contains($sql, 'for update')
        || ! preg_match('/\bfrom\s+["`]?menus["`]?/', $sql)
    ) {
        return;
    }

    $menuLockObserved = true;
    file_put_contents($signalDirectory.'/'.$workerId.'.locked', 'locked');

    if ($holdAfterLock) {
        $gate = fopen($signalDirectory.'/gate', 'c+');

        if ($gate === false) {
            throw new \RuntimeException('Unable to open the translation concurrency gate.');
        }

        try {
            if (! flock($gate, LOCK_EX)) {
                throw new \RuntimeException('Unable to wait on the translation concurrency gate.');
            }

            flock($gate, LOCK_UN);
        } finally {
            fclose($gate);
        }
    }

    if ($failAfterLock) {
        throw new \RuntimeException('Intentional failure after acquiring the menu lock.');
    }
});

$result = ['status' => 'error', 'message' => 'Worker did not execute.'];

try {
    $menu = Menu::query()->findOrFail($menuId);

    app(SaveMenuTranslationsAction::class)->execute($menu, (string) $locale, [
        'menu_title' => (string) $menuTitle,
        'categories' => [[
            'public_id' => (string) $categoryPublicId,
            'name' => (string) $categoryName,
        ]],
        'products' => [[
            'public_id' => (string) $productPublicId,
            'name' => (string) $productName,
            'description' => (string) $productDescription,
        ]],
    ]);

    $result = ['status' => 'success'];
} catch (\Throwable $exception) {
    $result = [
        'status' => 'error',
        'exception' => $exception::class,
        'message' => $exception->getMessage(),
    ];
}

file_put_contents(
    $signalDirectory.'/'.$workerId.'.result',
    json_encode($result, JSON_THROW_ON_ERROR),
);

exit($result['status'] === 'error' ? 1 : 0);
